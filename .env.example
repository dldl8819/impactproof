# App
APP_NAME=ImpactProof
APP_ENV=development
APP_DEBUG=true
API_PORT=8000
FRONTEND_PORT=5173

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (local host access)
POSTGRES_DB=impactproof
POSTGRES_USER=impactproof
POSTGRES_PASSWORD=impactproof
DATABASE_URL=postgresql+psycopg://impactproof:impactproof@localhost:5432/impactproof

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Frontend
VITE_API_BASE_URL=http://localhost:8000
